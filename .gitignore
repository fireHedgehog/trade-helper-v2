# trade-helper-v2 — polyglot repo (Python backend + Node frontend + docs).
# Kept deliberately small. Build-output patterns are SCOPED to a directory so
# they can't silently swallow a source folder named "lib" / "build" / "dist".

# --- OS ---
.DS_Store
Thumbs.db

# --- Python (backend) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
backend/build/
backend/dist/

# --- Node (frontend) ---
node_modules/
frontend/dist/
*.tsbuildinfo

# --- Secrets / local env (templates stay: *.env.example) ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local

# --- Local runtime database (disposable, rebuilt from schema/ on startup) ---
database/*.sqlite3
database/*.sqlite3-wal
database/*.sqlite3-shm
database/*.sqlite3-journal

# --- Editors ---
.idea/
*.swp
*~
# .vscode/ is intentionally NOT ignored — commit shared workspace settings if any.

# --- Logs ---
*.log
