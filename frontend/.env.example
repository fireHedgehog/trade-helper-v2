# Copy to frontend/.env.local to override defaults.

# Base URL for API calls. Default "/api" goes through the Vite dev proxy
# (see vite.config.ts) to the backend. Set an absolute URL to bypass the proxy.
# VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api. Only used in dev.
# VITE_API_PROXY_TARGET=http://localhost:8000
