# Copy to backend/.env and adjust as needed. All settings are optional and
# have working defaults.

# Absolute or relative path to the SQLite file. Defaults to
# ../database/trade_helper.sqlite3 (the repo's database/ folder).
# DATABASE_PATH=../database/trade_helper.sqlite3

# CORS origins allowed to call the API (the Vite dev server).
# CORS_ORIGINS=["http://localhost:5173"]

# Alpaca base URL used only by the credential "Verify" action. Paper trading
# by default — safe, read-only account check, submits no orders.
# ALPACA_API_BASE=https://paper-api.alpaca.markets

# FRED base URL used only by the credential "Verify" action.
# FRED_API_BASE=https://api.stlouisfed.org

# OpenAI base URL — credential "Verify" and the Macro AI regime feature.
# Point at any OpenAI-compatible endpoint if desired.
# OPENAI_API_BASE=https://api.openai.com

# Optional environment-variable fallback for secrets when the OS keychain has
# no entry. The backend reads these; it never writes them.
# FRED_API_KEY=
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# OPENAI_API_KEY=
